{
  "name": "marketing-uplift-decision-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run verify:data && npm run check && vite build && node scripts/audit-dist.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "format": "prettier --write src tests scripts index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests scripts index.html vite.config.ts tsconfig.json package.json",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
